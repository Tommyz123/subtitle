# ===========================================
# 转录模式配置
# ===========================================
# 转录模式: local (本地模型) 或 api (OpenAI API)
# local: 离线运行，免费，需要 GPU/CPU 资源
# api: 在线调用，按量付费，无需本地资源
WHISPER_MODE=api

# 本地模型大小（仅在 local 模式下使用）
# 可选: tiny, base, small, medium, large-v2
# 推荐: base (速度快，精度适中，1GB显存)
LOCAL_MODEL_SIZE=base

# ===========================================
# OpenAI API 配置 (仅在 api 模式下需要)
# ===========================================
# 获取地址: https://platform.openai.com/api-keys
# 格式: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# DeepL API 配置
# ===========================================
# 获取地址: https://www.deepl.com/pro-api
# 免费版格式: xxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# 付费版格式: xxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DEEPL_API_KEY=your_deepl_api_key_here

# ===========================================
# 音频捕获配置（可选）
# ===========================================
# VB-Cable 默认采样率
AUDIO_SAMPLE_RATE=48000

# 音频分块时长（秒）
# 较小值: 延迟低，但 API 调用频繁
# 较大值: 延迟高，但成本节省
AUDIO_CHUNK_DURATION=5

# 启用音频播放（通常不需要启用）
# ⚠️ 警告：启用此选项可能导致回声问题！
#
# 推荐解决VB-CABLE无声问题的方法：
# 使用Windows自带的"侦听此设备"功能（无回声，零延迟）
# 步骤：
# 1. 右键点击任务栏的音量图标 → 声音设置
# 2. 相关设置 → 声音控制面板
# 3. 找到"CABLE Output" → 右键 → 属性
# 4. "侦听" 标签页 → 勾选"侦听此设备"
# 5. 选择播放设备为你的扬声器/耳机 → 应用
#
# false: 禁用程序内播放（推荐，使用Windows侦听功能）
# true: 启用程序内播放（可能有回声和延迟）
ENABLE_PLAYBACK=false

# ===========================================
# 语言配置（可选）
# ===========================================
# 源语言（Whisper 转录）
# 支持: en, zh, ja, ko, fr, de 等
SOURCE_LANGUAGE=en

# 目标语言（DeepL 翻译）
# 支持: ZH, EN-US, JA, KO, FR, DE 等
TARGET_LANGUAGE=ZH

# ===========================================
# VAD（语音活动检测）配置
# ===========================================
# 启用/禁用 VAD
# 值: true, false, 1, 0, yes, no, on, off
ENABLE_VAD=true

# VAD 语音概率阈值（0.0-1.0）
# 0.3: 宽松（捕获更多，成本略高）
# 0.5: 平衡（推荐）
# 0.7: 严格（节省成本，可能漏检）
VAD_THRESHOLD=0.5

# VAD 最小静音持续时间（毫秒）
# 避免短暂停顿被误判为静音
VAD_MIN_SILENCE_MS=500
