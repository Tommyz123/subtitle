# ===========================================
# 转录模式配置
# ===========================================
# 转录模式: local (本地模型) 或 api (OpenAI API)
# local: 离线运行，免费，需要 GPU/CPU 资源
# api: 在线调用，按量付费，无需本地资源
WHISPER_MODE=api

# 本地模型大小（仅在 local 模式下使用）
# 可选: tiny, base, small, medium, large-v2
# 推荐: base (速度快，精度适中，1GB显存)
LOCAL_MODEL_SIZE=base

# 本地翻译（仅在 local 模式下可用）
# true: 使用本地 NLLB 模型翻译（速度快 < 100ms，完全离线）
# false: 使用 DeepL API 翻译（质量高，需要网络）
# 注意: 首次使用会自动下载 NLLB 模型（约 1.2GB）
USE_LOCAL_TRANSLATION=true

# ===========================================
# OpenAI API 配置 (仅在 api 模式下需要)
# ===========================================
# 获取地址: https://platform.openai.com/api-keys
# 格式: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# DeepL API 配置
# ===========================================
# 获取地址: https://www.deepl.com/pro-api
# 免费版格式: xxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
# 付费版格式: xxxxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DEEPL_API_KEY=your_deepl_api_key_here

# ===========================================
# 音频捕获配置（可选）
# ===========================================
# VB-Cable 默认采样率
AUDIO_SAMPLE_RATE=48000

# 音频分块时长（秒）
# 较小值: 延迟低，但 API 调用频繁
# 较大值: 延迟高，但成本节省
AUDIO_CHUNK_DURATION=5

# 启用音频播放（解决VB-CABLE无声问题）
#
# ⚠️ 重要：选择以下两种方式之一，不要同时使用！
#
# 方式1：使用 Windows "侦听此设备"功能（推荐）
#   设置：ENABLE_PLAYBACK=false
#   配置：声音控制面板 → 录制 → CABLE Output → 属性 → 侦听标签
#         勾选"侦听此设备"，选择你的扬声器
#   优点：零延迟，系统原生支持
#
# 方式2：使用程序内播放
#   设置：ENABLE_PLAYBACK=true
#   要求：必须关闭 Windows "侦听此设备"功能
#   优点：自动选择物理设备，延迟约30ms
#
# 如果有回声，说明两种方式同时开启了！
# 解决：关闭其中一种
#
ENABLE_PLAYBACK=false

# ===========================================
# 语言配置（可选）
# ===========================================
# 源语言（Whisper 转录）
# 支持: en, zh, ja, ko, fr, de 等
SOURCE_LANGUAGE=en

# 目标语言（DeepL 翻译）
# 支持: ZH, EN-US, JA, KO, FR, DE 等
TARGET_LANGUAGE=ZH

# ===========================================
# VAD（语音活动检测）配置
# ===========================================
# 启用/禁用 VAD
# 值: true, false, 1, 0, yes, no, on, off
ENABLE_VAD=true

# VAD 语音概率阈值（0.0-1.0）
# 0.3: 宽松（捕获更多，成本略高）
# 0.5: 平衡（推荐）
# 0.7: 严格（节省成本，可能漏检）
VAD_THRESHOLD=0.5

# VAD 最小静音持续时间（毫秒）
# 避免短暂停顿被误判为静音
VAD_MIN_SILENCE_MS=500

# ===========================================
# Figma API 配置（可选）
# ===========================================
# 获取地址: https://www.figma.com/developers/api#access-tokens
# 格式: figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIGMA_ACCESS_TOKEN=your_figma_access_token_here
